{
    "name": "msc/slider-constructor",
    "description": "Drag & Drop Slider Constructor for Laravel — admin panel + frontend embed",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "slider", "drag-drop", "constructor", "admin"],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Msc\\SliderConstructor\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Msc\\SliderConstructor\\SliderConstructorServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
